      "item_id": "video-premiere-pro-ai-tools-pjobx9xqvgi-youtube-38f15be5",
      "title": "Eight AI Tools in Premiere Pro: Remix, Extend, Transcription, and More",
      "media": [
        {
          "type": "youtube",
          "video_id": "PjObX9XQvgI",
          "url": "https://www.youtube.com/watch?v=PjObX9XQvgI"
